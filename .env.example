# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Agrega tu IP de red local (ej. 192.168.x.x) para poder probar la app
# móvil con Expo Go desde un celular físico en la misma WiFi.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB - desarrollo local (coincide con docker-compose.yml)
MONGO_DB_NAME=tienda_db
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=admin123
MONGO_AUTH_SOURCE=admin

# MongoDB - producción (Render + MongoDB Atlas)
# Si se define MONGO_URI, tiene prioridad sobre las variables sueltas de arriba.
# Ejemplo: mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/tienda_db?retryWrites=true&w=majority
# MONGO_URI=

# JWT
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# CORS - orígenes permitidos del frontend (web/móvil), separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Chatbot IA (Claude / Anthropic)
ANTHROPIC_API_KEY=
